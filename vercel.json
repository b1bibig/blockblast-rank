{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@3.1.0",
      "pythonVersion": "3.11"
    }
  },
  "routes": [
    {
      "src": "/ranking",
      "dest": "/api/index.py"
    },
    {
      "src": "/([^/]+)/([^/]+)/([^/]+)",
      "dest": "/api/index.py"
    }
  ]
}
